    "normalization_rules": {
      "Node.js": "NodeJS / Node.js / nodejs \u2192 Node.js",
      "React": "ReactJS / React.js \u2192 React",
      "Vue.js": "VueJS / Vue.js \u2192 Vue.js",
      "Next.js": "NextJS / Next.js \u2192 Next.js",
      "scikit-learn": "sklearn / scikit-learn \u2192 scikit-learn",
      "PostgreSQL": "Postgres / PostgreSQL / Postgre SQL \u2192 PostgreSQL",
      "TensorFlow": "Tensorflow / TensorFlow \u2192 TensorFlow",
      "JavaScript": "JS / Javascript / JavaScript \u2192 JavaScript",
      "TypeScript": "TS / Typescript / TypeScript \u2192 TypeScript",
      "C++": "CPP / c++ \u2192 C++",
      "C#": "CSharp / C Sharp / C# \u2192 C#",
      "ASP.NET": "ASP.NET / asp.net / asp net \u2192 ASP.NET",
      "SQL Server": "MSSQL / MS SQL / SQL Server \u2192 SQL Server"
    },
    "usage": {
      "precision": "precision = |extracted_skills \u2229 annotated_skills| / |extracted_skills|",
      "recall": "recall    = |extracted_skills \u2229 annotated_skills| / |annotated_skills|",
      "f1": "F1 = 2 * precision * recall / (precision + recall)",
      "fpr": "false_positive_rate = |extracted_skills - annotated_skills| / |extracted_skills|"
    }
  },

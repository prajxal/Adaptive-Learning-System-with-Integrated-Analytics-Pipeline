  "metadata": {
    "description": "Ground-truth skill annotation dataset for ENGINEERING resume corpus",
    "purpose": "Evaluate precision, recall, and false-positive rate of the LearnPathAI skill-extraction pipeline",
    "annotation_method": "Human-quality annotation via curated vocabulary (~75 canonical skills) with context-aware regex extraction and manual post-filters to remove false positives. Annotated skills reflect only technical skills relevant to software engineering (programming languages, frameworks, databases, tools, DevOps, ML libraries). Soft skills, generic words, and non-evidence mentions are excluded.",
    "corpus": {
      "source_folder": "ENGINEERING/",
      "total_resumes": 118,
      "resumes_with_sw_skills": 69,
      "resumes_with_zero_sw_skills": 49,
      "note": "49 resumes have 0 software-engineering skills because they belong to hardware, civil, mechanical, or general management engineering roles."
    },
